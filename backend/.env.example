PORT=4000
JWT_SECRET=change-this-secret-before-any-public-use
PASSWORD_SALT=demo-shop-salt-change-me
# Real integrations are NOT configured in this demo build.
# Do not put real keys in the frontend HTML file.
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
# PATHAO_CLIENT_ID=
# PATHAO_CLIENT_SECRET=

# MongoDB Atlas (v2) - set ONLY as an environment variable, never in code or chat.
# On Render: Dashboard > demo-shop > Environment > Add MONGODB_URI (your Atlas
# connection string, with <password> replaced by your Atlas database user password)
# and MONGODB_DB=demo-shop, then redeploy. Without MONGODB_URI the server
# keeps working with the JSON-file database.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=demo-shop
